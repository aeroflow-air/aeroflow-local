<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Source only. Do not put a token in this file.
         GitHub Packages requires auth even for public packages.
         Once sibling svc-* repos restore AeroFlow.ServiceDefaults from this feed,
         local AppHost restore needs a PAT with read:packages in your user-level
         NuGet config (see README). -->
    <add key="aeroflow-air" value="https://nuget.pkg.github.com/aeroflow-air/index.json" />
  </packageSources>
</configuration>
