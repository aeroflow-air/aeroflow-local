{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HealthStrip": {
    "PollSeconds": 10,
    "Services": [
      "svc-flight-status",
      "svc-gate-allocation",
      "svc-baggage-reclaim"
    ]
  },
  "Snapshot": {
    "HomeAirport": "LHR",
    "FlightStatusUrl": "http://svc-flight-status",
    "GateAllocationUrl": "http://svc-gate-allocation",
    "BaggageReclaimUrl": "http://svc-baggage-reclaim",
    "RetrySeconds": 5,
    "MaxAttempts": 24
  }
}
